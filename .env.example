# Copy this file to .env.local and fill values from the FYERS API Dashboard.
# NEVER commit .env.local.

FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=http://127.0.0.1:8080/callback


# Optional live-news inputs.
# Leave blank unless configured locally. Never commit real tokens.
NEWS_X_BEARER_TOKEN=
# Optional entitled X streaming endpoint. When blank, the app falls back to
# recent-search polling if NEWS_X_BEARER_TOKEN is present.
NEWS_X_STREAM_URL=
# Optional X recent-search query override.
NEWS_X_QUERY=
# Optional recent-search polling interval in milliseconds (minimum 5000).
NEWS_X_POLL_MS=15000

# Persistent exact buyer/seller trade tape.
# Use a dedicated Supabase project/schema for ALLINONEVIEW.
# Never expose the service-role key to the browser.
ORDER_FLOW_SUPABASE_URL=
ORDER_FLOW_SUPABASE_SERVICE_ROLE_KEY=
# Symbols recorded even when nobody has the chart open.
ORDER_FLOW_KRAKEN_SYMBOLS=BTC/USD,ETH/USD,SOL/USD,XRP/USD
